#include <stdio.h>
#define _CRT_SECURE_NO_WARNINGS

int main() {

	int aa[100] = {0};

	int num;

	printf("n번째 피보나치 수를 구하기 위한 숫자 n을 선택하시오. ");
	scanf_s("%d", &num);

	aa[0] = 0;
	aa[1] = 1;

	for (int i = 2; i < num; i++) {
		aa[i] = aa[i - 2] + aa[i - 1];
	}

	printf("%d", aa[num-1]);
	 
	return 0;
}

## 과제 2 보고서

배열의 크기를 100으로 정해서 입력될 숫자들을 최대한 수용할 수 있도록 하였다.

첫 번째, 두 번째 배열의 값을 정한 상태에서 피보나치 방법으로 입력된 숫자까지 값이 더해지는 형태를 반복시켰다.
