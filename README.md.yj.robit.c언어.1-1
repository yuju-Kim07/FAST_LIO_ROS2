#include <stdio.h>
#define _CRT_SECURE_NO_WARNINGS

int main() {

	float aa[5] = {0};

	for (int i = 0; i < 5; i++) {
		printf(" %d 번째 실수를 입력하시오. ", i+1);
		scanf_s("%f", &aa[i]);
	}

	printf("---- 결과 ----\n");

	float average;
	float sum = 0;

	for (int i = 0; i < 5; i++) {
		sum += aa[i];
	}

	average = sum / 5;

	float max = aa[0];

	for (int i = 0; i < 5; i++) {
		if (max <= aa[i]) {
			max = aa[i];
		}
	}

	float min = aa[0];

	for (int i = 0; i < 5; i++) {
		if (min >= aa[i]) {
			min = aa[i];
		}
	}

	printf("평균은 %f입니다.\n", average);
	printf("최댓값은 %f입니다.\n", max);
	printf("최솟값은 %f입니다.\n", min);

	return 0;

}


## 과제 1 보고서

크기가 5인 실수형 배열을 선언하고 5개의 실수를 입력받아, 배열에 저장했다.

초기화시킨 배열 5개의 합(sum)을 구한 후 이를 이용하여 평균을 구했다.(average)

최댓값(max)을 aa[0]로 초기화 시킨후 배열 원소를 하나씩 비교시키면서 최댓값을 찾았다.
(최솟값(min)도 같은 방법을 사용했다.)
