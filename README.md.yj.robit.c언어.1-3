#include <stdio.h>
#define _SRT_SECUURE_NO_WARNINGS

int main() {

	int year = 0;

	printf("년도를 입력하세요 : ");
	scanf_s("%d", &year);

	if (year % 4 == 0 && year % 100 != 0 || year % 400 == 0) {

		printf("윤년");

	}

	else {

		printf("윤년이 아님");

	}

	return 0;

}

과제 3 보고서

년도를 입력받았다.

윤년의 정의를 조건문(if)의 조건식으로 쓴 후 조건을 만족할 시 윤년, 그렇지 않으면 윤년이 아니라는 출력값을 냈다.
