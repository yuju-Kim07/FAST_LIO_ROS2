# *장소 혹은 경도와 위도에 따른 산림, 기후, 고도정도 파악*
# *사용자가 위치 입력시 정보 출력*

### *이용 라이브러리*
from geopy.geocoders import Nominatim #사용자 입력 위치를 위도, 경도로 바꾸기
from shapely.geometry import Point, Polygon #좌표 영역 체크
from pyproj import Geod #좌표간 실제 거리 오차 줄이기 위해

import requests #웹상에서위성, 기후 데이터 받아오기
import folium #받아온 데이터 결과를 지도 화면으로 시각화

import time #시간 조절
import webbrowser #지도 보기
import os


### 코드 순서
1. 위치 옵션 방법 선택(국가나 주소  ///  위도와 경도)
2. 입력된 위치에 따른 위도와 경도 파악
3. 라이브러리에 있는 위성, 기후 데이터를 통해 지역 정보 파악
4. 검색한 정보들을 주소에 저장


### main.py 코드
from geopy.geocoders import Nominatim #사용자 입력 위치를 위도, 경도로 바꾸기
from shapely.geometry import Point, Polygon #좌표 영역 체크
from pyproj import Geod #좌표간 실제 거리 오차 줄이기 위해

import requests #웹상에서위성, 기후 데이터 받아오기
import folium #받아온 데이터 결과를 지도 화면으로 시각화

import time #시간 조절
import webbrowser #지도 보기
import os

geolocator=Nominatim(user_agent="my_eco_app")

while True:
    print("1. 국가/주소  2. 위도&경도")

    user_search_set=input("입력할 값을 선택하세요.")

    if user_search_set=="1": #국가/주소 선택
        user_input=input("검색할 국가나 주소를 입력하세요. :").strip() #띄어쓰기 없애기

        try:
           time.sleep(1) #API과부화 줄이기 위해 1초 대기
           user_search_location=geolocator.geocode(user_input, language="ko", timeout=10) #주소를 숫자 좌표로 받기

           if user_search_location: #위치가 존재할 때
               address_parts=user_search_location.address.split(',') #,로 시,도, 군 쪼개기
               refined_name=address_parts[-1].strip() if address_parts else user_input #마지막 선택

               lat=user_search_location.latitude #주소의 위도
               lon=user_search_location.longitude #주소의 경도
               full_address=user_search_location.address #주소의 전체값

           else:
              print("검색결과가 없으니 다시 입력해주세요. ") #끝에 국가명이 나오므로, 맨 끝값을 추출
              continue

        except Exception as e:
            print("위치 정보에 에러가 발생.")
            print("잠시 후 다시 시도해주세요. ")
            continue

    elif user_search_set=="2":
        while True:

            lat_input=input("위도를 입력해주세요. (-90~+90): ").strip() #위도 직접 입력
            try:
                user_lat=float(lat_input)
                if -90<=user_lat<=90:
                    lat=user_lat
                    break
                else:
                    print("위도값이 범위를 벗어났습니다. 다시 입력하세요. ")

            except ValueError:
                print("올바른 숫자를 입력하세요.")

        while True:

            lon_input=input("경도를 입력해주세요. (-180~+180): ").strip() #경도 직접 입력
            try:
                user_lon=float(lon_input)
                if -180<=user_lon<=180:
                    lon=user_lon
                    break
                else:
                    print("경도값이 범위를 벗어났습니다. 다시 입력하세요. ")

            except ValueError:
                print("올바른 숫자를 입력하세요.")

        
        print("좌표의 주소 조회중...")

        try:
            time.sleep(1) #과부화 방지

            user_search_location_result=geolocator.reverse((lat, lon), language="ko", timeout=10)

            if user_search_location_result: #위치 조회 성공
                address_parts=user_search_location_result.address.split(',')
                refined_name=address_parts[-1].strip() if address_parts else "알 수 없는 지역"
                print(f"확인된 위치: {refined_name} ({user_search_location_result.address})")
            else:
                refined_name="위치 조회 불가"
                print("확인된 위치는 주소가 없습니다. ")

                print("\n" + "-"*30)
                print(f"좌표 입력 성공!")
                print(f"위도(Lat): {lat:.4f}")
                print(f"경도(Lon): {lon:.4f}")
                print(f"대략적인 위치: {refined_name}")
                print("-"*30)

        except Exception as e: #오류가 떠도 저장
            print("다시 입력하세요")

    else:
        print("값을 잘못 입력했습니다.")
        continue

    print(f"\n {refined_name} 지역의 기후 및 산림 분포도를 수집하는 중...")

    abs_lat = abs(lat) #위도의 절댓값
    if abs_lat <= 23.5: 
        climate_zone = "열대/아열대 기후 (연중 고온 지역)"
    elif abs_lat <= 50:
        climate_zone = "온대/냉대 기후 (대한민국 포함 사계절 뚜렷한 지역)"
    else:
        climate_zone = "한대/툰드라 기후 (극지방 인근 매우 추운 지역)"

    url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=soil_moisture_0_to_10cm&elevation=1"

    try:
        response = requests.get(url, timeout=10) #응답을 최대 10초 기다림
        if response.status_code == 200: #인터넷 연결이 잘 됨
            data = response.json() #원본 데이터를 파이썬 형식으로 바꿈
            elevation = data.get("elevation", 0) #해발고도. request사용
            soil_moisture = data.get("current", {}).get("soil_moisture_0_to_10cm") #토양 수분량
            if soil_moisture is None:
                soil_moisture=0.0
            
            forest_percentage = min(max(int(soil_moisture * 200), 0), 100)
            
            print("\n" + "="*15 + " [환경 분석 결과] " + "="*15)
            print(f"🔹 분석 대상 지역: {refined_name}")
            print(f"🔹 판별된 기후대: {climate_zone}")
            print(f"🔹 지역 해발 고도: {elevation} m")
            print(f"🔹 추정 산림 분포도: {forest_percentage}%")
            print("="*48 + "\n")

            my_map = folium.Map( #위성 지도 보기
                location=[lat, lon], 
                zoom_start=7, #지도 확대 비율
                tiles="https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}", #Esri 지원 고해상 지도
                attr="Esri Satellite" #지도 출처
            )
           
            popup_content = f"<b> {refined_name}</b><br>고도: {elevation}m<br>산림 밀도: {forest_percentage}%" #팝업창 형태로 나올 내용
           
            folium.Marker(#지정 위치에 핀 꽂기
                location=[lat, lon],
                popup=folium.Popup(popup_content, max_width=200),
                icon=folium.Icon(color="darkgreen", icon="tree", prefix="fa") #핀 모양은 나무, 색깔은 진한 초록
            ).add_to(my_map)
            
            my_map.save("forest_satellite_map.html")
            print("[지도 배포] 산림을 눈으로 확인하는 'forest_satellite_map.html' 파일이 저장되었습니다!\n")

            abs_path = os.path.abspath("forest_satellite_map.html")
            print("생성된 지도를 브라우저에서 자동으로 엽니다...")
            webbrowser.open(f"file://{abs_path}")
            
            break # 반복문 종료

        else:
            print("오픈 API 서버로부터 기후 데이터를 가져오지 못했습니다.")
            
    except Exception as e:
        print(f"기후 데이터 수집 및 지도 생성 중 에러 발생: {e}")

